// Polyfill for C++20's <source_location>, used only as a fallback include
// path (see binding.gyp's `-idirafter`) for toolchains whose libc++ predates
// this header. Electron 43+'s V8 headers (v8-source-location.h) unconditionally
// `#include <source_location>`, which fails to compile on older Xcode Command
// Line Tools SDKs even though the compiler itself supports the underlying
// __builtin_FILE/__builtin_LINE/__builtin_FUNCTION/__builtin_COLUMN builtins.
#ifndef PANEL_WINDOW_SOURCE_LOCATION_SHIM_
#define PANEL_WINDOW_SOURCE_LOCATION_SHIM_

#include <cstdint>

namespace std {

class source_location {
 public:
  static constexpr source_location current(
      const char* file = __builtin_FILE(),
      const char* func = __builtin_FUNCTION(),
      uint_least32_t line = __builtin_LINE(),
      uint_least32_t column = __builtin_COLUMN()) noexcept {
    source_location loc;
    loc.file_ = file;
    loc.func_ = func;
    loc.line_ = line;
    loc.column_ = column;
    return loc;
  }

  constexpr source_location() noexcept = default;

  constexpr uint_least32_t line() const noexcept { return line_; }
  constexpr uint_least32_t column() const noexcept { return column_; }
  constexpr const char* file_name() const noexcept { return file_; }
  constexpr const char* function_name() const noexcept { return func_; }

 private:
  const char* file_ = "";
  const char* func_ = "";
  uint_least32_t line_ = 0;
  uint_least32_t column_ = 0;
};

}  // namespace std

#endif  // PANEL_WINDOW_SOURCE_LOCATION_SHIM_
